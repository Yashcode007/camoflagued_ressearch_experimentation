# ==============================================================================
# Camouflage-Aware Medical Image Segmentation Environment Configuration
# ==============================================================================

# Device Configuration
# Set to 'cuda' if NVIDIA GPU is available, else 'cpu'
DEVICE=cuda

# Random Seeds for Multi-Seed Training
SEEDS=42,123,2026

# Training Hyperparameters
IMAGE_SIZE=256
BATCH_SIZE=8
BASE_CHANNELS=64
WIDE_CHANNELS=92
LEARNING_RATE=0.0001
MAX_EPOCHS=50
PATIENCE=10
USE_AMP=True
DETERMINISTIC=True

# Dataset Paths (Local Directory Paths)
DATA_DIR=./data
COD10K_DIR=./data/COD10K
KVASIR_DIR=./data/Kvasir-SEG
ISIC_DIR=./data/ISIC2016

# External Polyp Generalization Benchmark Paths
CVC_CLINICDB_DIR=./data/CVC-ClinicDB
CVC_COLONDB_DIR=./data/CVC-ColonDB
ETIS_DIR=./data/ETIS-LaribPolypDB

# Checkpoints and Outputs Directory
CHECKPOINT_DIR=./checkpoints
OUTPUT_DIR=./outputs
RESULTS_DIR=./results

# Kaggle API Credentials (Replace with your own credentials)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
